{
  "id": null,
  "uid": "ledgerlens-operations",
  "title": "LedgerLens / Operations",
  "description": "Latency, cost and reliability of agent runs (T-034). Sources: runs, steps, llm_calls, tool_calls.",
  "tags": ["ledgerlens", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS runs FROM runs WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "description": "Share of finished runs with status = succeeded.",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "green", "value": 0.9}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(avg(CASE WHEN status = 'succeeded' THEN 1.0 ELSE 0.0 END), 0) AS success_rate FROM runs WHERE $__timeFilter(created_at) AND status <> 'running'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM cost (range)",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0)::float8 AS cost_usd FROM llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Run latency p95",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95_ms FROM runs WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fallback share",
      "description": "Share of llm_calls where the router fell back to another tier.",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.2},
              {"color": "red", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(avg(CASE WHEN fallback_used THEN 1.0 ELSE 0.0 END), 0) AS fallback_share FROM llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Local LLM share",
      "description": "Share of llm_calls served by the local tier (provider = ollama) — the tiered-routing marker.",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(avg(CASE WHEN provider = 'ollama' THEN 1.0 ELSE 0.0 END), 0) AS local_share FROM llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Run statuses over time",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "succeeded"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
          },
          {
            "matcher": {"id": "byName", "options": "failed"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "budget_exceeded"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, status AS metric, count(*) AS value FROM runs WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Run latency p50 / p95",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS p50_ms, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95_ms FROM runs WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cost per run (USD)",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, avg(cost_usd)::float8 AS avg_cost_usd, max(cost_usd)::float8 AS max_cost_usd FROM runs WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM cost per day (USD)",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {"mode": "none"}
          },
          "color": {"mode": "fixed", "fixedColor": "semi-dark-yellow"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, sum(cost_usd)::float8 AS cost_usd FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Fallback share over time",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "fixed", "fixedColor": "orange"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, avg(CASE WHEN fallback_used THEN 1.0 ELSE 0.0 END) AS fallback_share FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Cost by task_class",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 6, "x": 0, "y": 22},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": [], "fields": ""},
        "pieType": "donut",
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT task_class, sum(cost_usd)::float8 AS cost_usd FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Cost by provider",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 6, "x": 6, "y": 22},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": [], "fields": ""},
        "pieType": "donut",
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider, sum(cost_usd)::float8 AS cost_usd FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "LLM calls: local vs cloud",
      "description": "provider = 'ollama' counts as local; everything else is a cloud tier.",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 22},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "local"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]
          },
          {
            "matcher": {"id": "byName", "options": "cloud"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, CASE WHEN provider = 'ollama' THEN 'local' ELSE 'cloud' END AS metric, count(*) AS value FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tool latency p95 by tool",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 31},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, tool AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS value FROM tool_calls WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Tool calls by status",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 31},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "ok"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
          },
          {
            "matcher": {"id": "byName", "options": "error"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, $__interval) AS time, status AS metric, count(*) AS value FROM tool_calls WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "Tool errors (non-ok statuses)",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []},
      "options": {"showHeader": true},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT tool, status, count(*) AS errors, max(created_at) AS last_seen FROM tool_calls WHERE $__timeFilter(created_at) AND status <> 'ok' GROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "LLM errors",
      "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []},
      "options": {"showHeader": true},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "ledgerlens-postgres"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider, model, left(error, 120) AS error, count(*) AS errors, max(created_at) AS last_seen FROM llm_calls WHERE $__timeFilter(created_at) AND error IS NOT NULL GROUP BY 1, 2, 3 ORDER BY 4 DESC LIMIT 50"
        }
      ]
    }
  ]
}
