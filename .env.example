# LedgerLens environment. Copy to .env and fill in secrets; .env is gitignored.
# Contract: CONTRACTS.md §5. Changing this file = changing the config contract.
#
# Comments live on their own line, never trailing a value: python-dotenv only
# strips a trailing "# ..." for quoted values, not unquoted ones — an
# unquoted empty value like `EDGAR_PROXY_URL=  # comment` silently becomes
# the *comment text itself*, which then fails wherever that value is parsed
# strictly (found live in CI, T-030: httpx rejected it as a proxy URL).

# --- Application ---
# APP_MODE: us | ru — active data source mode
APP_MODE=us
# APP_ENV: dev | demo | prod
APP_ENV=dev
# BUDGET_PROFILE: dev | demo — limits from config/budgets.yaml
BUDGET_PROFILE=dev

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledgerlens
POSTGRES_USER=app
POSTGRES_PASSWORD=
# read-only role app_ro — the only role sql_query uses
POSTGRES_RO_PASSWORD=

# --- Vector store / local inference ---
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
# T-002 default (sparse-MoE, 17GB Q4); light fallback qwen3.5:4b; final pick
# by T-037 benchmark. Empty = no-local mode (router drops the local tier).
LOCAL_MODEL=qwen3.5:27b

# --- Cloud LLM providers (optional; router only uses tiers whose key is present) ---
# Q-01: the only cloud provider (cheap=deepseek-v4-flash, strong/judge=deepseek-v4-pro)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# EOD prices for price_enrich (T-033); free key at alphavantage.co
ALPHAVANTAGE_API_KEY=

# --- SEC EDGAR ---
# required by SEC fair-use rules (Q-11); startup fails without it
EDGAR_USER_AGENT="ledgerlens zzlawlzz5@gmail.com"
# optional egress proxy for *.sec.gov only (RU-node mitigation, T-008)
EDGAR_PROXY_URL=

# --- Cost control ---
# Q-07: $50/month budget -> daily cap
DAILY_COST_CAP_USD=1.5

# --- A2A / workers ---
A2A_TOKEN=
# WORKER_NODE_NAME: local | vps-fi
WORKER_NODE_NAME=local

# --- Monitoring layer B (Q-03: Telegram; empty token = dry-run, alerts to log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret between n8n and /api/monitor/* (T-035). Empty = auth disabled (dev).
MONITOR_TOKEN=

# --- Ops ---
# Grafana admin login (T-034); anonymous access is viewer-only. Empty = "admin"
GRAFANA_ADMIN_PASSWORD=
# SELECT-only Postgres role for Grafana dashboards (created by migration 003)
GRAFANA_RO_PASSWORD=
N8N_ENCRYPTION_KEY=
