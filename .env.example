# LedgerLens environment. Copy to .env and fill in secrets; .env is gitignored.
# Contract: CONTRACTS.md §5. Changing this file = changing the config contract.

# --- Application ---
APP_MODE=us                # us | ru — active data source mode
APP_ENV=dev                # dev | demo | prod
BUDGET_PROFILE=dev         # dev | demo — limits from config/budgets.yaml

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledgerlens
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_RO_PASSWORD=      # read-only role app_ro — the only role sql_query uses

# --- Vector store / local inference ---
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=               # pinned by T-002 (default candidate: qwen3:30b-a3b MoE)

# --- Cloud LLM providers (optional; router only uses tiers whose key is present) ---
DEEPSEEK_API_KEY=          # Q-01: the only cloud provider (cheap=deepseek-chat, strong/judge=deepseek-reasoner)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- SEC EDGAR ---
EDGAR_USER_AGENT="ledgerlens zzlawlzz5@gmail.com"   # required by SEC fair-use rules (Q-11); startup fails without it
EDGAR_PROXY_URL=           # optional egress proxy for *.sec.gov only (RU-node mitigation, T-008)

# --- Cost control ---
DAILY_COST_CAP_USD=1.5     # Q-07: $50/month budget → daily cap

# --- A2A / workers ---
A2A_TOKEN=
WORKER_NODE_NAME=local     # local | vps-fi

# --- Monitoring layer B (Q-03: Telegram; empty token = dry-run, alerts to log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ops ---
GRAFANA_ADMIN_PASSWORD=
N8N_ENCRYPTION_KEY=
