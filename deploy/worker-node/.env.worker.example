# Remote worker node env (T-031). Copy to .env.worker on the VPS and fill in.
# This node runs ONLY the worker; it holds no secrets beyond the A2A token
# and the cloud LLM key.

# Shared bearer token — MUST match the main node's A2A_TOKEN exactly.
A2A_TOKEN=

# Cloud LLM for the worker's reasoning (same key as the main node).
DEEPSEEK_API_KEY=

# No local model on the VPS (cloud tier only).
LOCAL_MODEL=

# This node's identity — shows up as the step's worker_node badge in the UI.
WORKER_NODE_NAME=vps-fi

# AmneziaWG private addresses (see README.md). Defaults match the runbook.
AWG_SELF_IP=10.8.0.2
AWG_MAIN_IP=10.8.0.1

# Container image owner (ghcr) if pulling instead of building on the node.
GHCR_OWNER=zzlawlzz
